{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@packages/*": [
        "./packages/*"
      ],
      "@gestao_formatura/shared": [
        "./packages/shared/src"
      ],
      "@gestao_formatura/shared/*": [
        "./packages/shared/src/*"
      ],
      "@gestao_formatura/auth": [
        "./packages/auth/src"
      ],
      "@gestao_formatura/auth/*": [
        "./packages/auth/src/*"
      ],
      "@gestao_formatura/admin": [
        "./packages/admin/src"
      ],
      "@gestao_formatura/admin/*": [
        "./packages/admin/src/*"
      ],
      "@gestao_formatura/atirador": [
        "./packages/atirador/src"
      ],
      "@gestao_formatura/atirador/*": [
        "./packages/atirador/src/*"
      ],
      "@gestao_formatura/family-member": [
        "./packages/family-member/src"
      ],
      "@gestao_formatura/family-member/*": [
        "./packages/family-member/src/*"
      ],
      "@gestao_formatura/payment": [
        "./packages/payment/src"
      ],
      "@gestao_formatura/payment/*": [
        "./packages/payment/src/*"
      ],
      "@gestao_formatura/dashboard": [
        "./packages/dashboard/src"
      ],
      "@gestao_formatura/dashboard/*": [
        "./packages/dashboard/src/*"
      ],
      "@gestao_formatura/prisma/generated": [
        "./packages/shared/src/generated/client"
      ],
      "@prisma/client": [
        "./packages/shared/src/generated/client"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
