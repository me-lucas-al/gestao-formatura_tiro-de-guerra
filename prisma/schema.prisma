generator client {
  provider = "prisma-client-js"
}

datasource formatura_db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atiradores Atirador[]
}
model Payment {
  id         Int   @id @default(autoincrement())
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isPaid     Boolean  @default(false)
  atiradorId Int
  atirador      Atirador     @relation(fields: [atiradorId], references: [id])
}
model Atirador {
    id        Int   @id @default(autoincrement())
    name      String
    familyMemberQuantity Int
    adminId   Int
    admin     Admin  @relation(fields: [adminId], references: [id])
    payments Payment[]
}