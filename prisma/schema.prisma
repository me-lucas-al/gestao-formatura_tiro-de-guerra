// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../packages/shared/src/generated"
}

datasource formatura_db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  PAID
  FIRST_INSTALLMENT_PAID
  CANCELED
  ISENTO
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  password  String
  role      String   @default("ADMIN")
  year      Int?     @default(2025)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atiradores Atirador[]

  @@unique([name, year])
  @@unique([email, year])
}

model Payment {
  id             Int           @id @default(autoincrement())
  value          Float
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod
  year           Int           @default(2025)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  atiradorId     Int?          @unique
  familyMemberId Int?          @unique
  familyMember   FamilyMember?
  atirador       Atirador?     @relation(fields: [atiradorId], references: [id])
}

model Atirador {
  id            Int            @id @default(autoincrement())
  name          String
  number        Int
  year          Int            @default(2025)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  adminId       Int?
  paymentId     Int?           @unique
  payment       Payment?
  admin         Admin?         @relation(fields: [adminId], references: [id])
  familyMembers FamilyMember[]

  @@unique([number, year])
}

model FamilyMember {
  id         Int      @id @default(autoincrement())
  name       String
  age        Int
  atiradorId Int
  year       Int      @default(2025)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  paymentId  Int?     @unique
  payment    Payment? @relation(fields: [paymentId], references: [id])
  atirador   Atirador @relation(fields: [atiradorId], references: [id])
}
